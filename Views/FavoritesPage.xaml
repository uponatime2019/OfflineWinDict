<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OfflineWinDict.Views.FavoritesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:OfflineWinDict.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="28,22,28,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                <TextBlock Text="Favorites" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center"/>
                <TextBlock x:Name="FavoritesCountLabel" VerticalAlignment="Center" Foreground="{ThemeResource TextTertiaryBrush}" FontSize="14" Margin="0,4,0,0"/>
            </StackPanel>
            <Button x:Name="NewFolderButton" Grid.Column="1" Style="{StaticResource ChipButtonStyle}" Click="NewFolderButton_Click"
                    AutomationProperties.Name="New folder">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="13"/>
                    <TextBlock Text="New folder" FontSize="13"/>
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Folder list -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Folders" Style="{StaticResource SectionHeaderStyle}" Margin="10,8,10,8"/>
                    <ListView x:Name="FolderList" Grid.Row="1" SelectionMode="Single" IsItemClickEnabled="True"
                              ItemClick="FolderList_ItemClick" RightTapped="FolderList_RightTapped"
                              AutomationProperties.Name="Favorites folders">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="MinHeight" Value="40"/>
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </Grid>
            </Border>

            <!-- Words in folder -->
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ListView x:Name="FavoritesList" Grid.Row="0" Padding="12" SelectionMode="None" IsItemClickEnabled="True"
                              ItemClick="FavoritesList_ItemClick"
                              AutomationProperties.Name="Favorited words">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="MinHeight" Value="56"/>
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:FavoriteItem">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <FontIcon Grid.Column="0" Glyph="&#xE734;" FontSize="15" Foreground="{ThemeResource BrandGreenBrush}" VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="{x:Bind Word}" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}"/>
                                        <TextBlock Foreground="{ThemeResource TextTertiaryBrush}" FontSize="12">
                                            <Run Text="{x:Bind LanguageCode}"/><Run Text="  ·  "/><Run Text="{x:Bind Folder}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Button Style="{StaticResource IconActionButtonStyle}" Width="34" Height="34"
                                                Click="MoveItem_Click" Tag="{x:Bind}" AutomationProperties.Name="Move to folder" ToolTipService.ToolTip="Move to folder">
                                            <FontIcon Glyph="&#xE8DE;" FontSize="14"/>
                                        </Button>
                                        <Button Style="{StaticResource IconActionButtonStyle}" Width="34" Height="34"
                                                Click="RemoveItem_Click" Tag="{x:Bind}" AutomationProperties.Name="Remove from favorites" ToolTipService.ToolTip="Remove">
                                            <FontIcon Glyph="&#xE74D;" FontSize="13"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Empty state -->
                    <StackPanel x:Name="FavoritesEmptyState" Grid.Row="0" Spacing="12" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                        <FontIcon Glyph="&#xE734;" FontSize="42" Foreground="{ThemeResource AccentBlueFaintBrush}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="FavoritesEmptyTitle" Text="No favorites yet" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="FavoritesEmptyText" Text="Tap the star next to a word to save it here for quick access."
                                   Foreground="{ThemeResource TextSecondaryBrush}" FontSize="13.5" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="420" TextWrapping="Wrap"/>
                        <Button Content="Search a word" Style="{StaticResource ChipButtonStyle}" Foreground="{ThemeResource AccentBlueBrush}" HorizontalAlignment="Center" Click="GoSearch_Click"/>
                    </StackPanel>

                    <Rectangle Grid.Row="1" Height="1" Fill="{ThemeResource DividerBrush}" Margin="12,0,12,0"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="12,8,12,10" VerticalAlignment="Bottom">
                        <TextBlock x:Name="FolderHintLabel" Text="" Foreground="{ThemeResource TextTertiaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
