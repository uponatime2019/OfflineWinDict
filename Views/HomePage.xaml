<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OfflineWinDict.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OfflineWinDict"
    xmlns:models="using:OfflineWinDict.Models"
    xmlns:controls="using:OfflineWinDict.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="FocusSearch_Invoked"/>
        <KeyboardAccelerator Modifiers="Menu" Key="Left" Invoked="Back_Invoked"/>
        <KeyboardAccelerator Modifiers="Menu" Key="Right" Invoked="Forward_Invoked"/>
    </Page.KeyboardAccelerators>

    <Grid x:Name="RootGrid" Padding="28,22,28,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ─────────── Search row ─────────── -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <AutoSuggestBox
                x:Name="SearchBox"
                Grid.Column="0"
                QueryIcon="Find"
                FontSize="15"
                MinHeight="46"
                VerticalAlignment="Center"
                PlaceholderText="Search a word, phrase, or translation…"
                AutomationProperties.Name="Dictionary search box"
                TextChanged="SearchBox_TextChanged"
                QuerySubmitted="SearchBox_QuerySubmitted"/>

            <ComboBox
                x:Name="HomeDictionaryCombo"
                Grid.Column="1"
                MinWidth="190"
                MinHeight="46"
                VerticalAlignment="Center"
                AutomationProperties.Name="Dictionary language"
                SelectionChanged="HomeDictionaryCombo_SelectionChanged"/>
        </Grid>

        <!-- ─────────── Content: results column + detail panel ─────────── -->
        <Grid Grid.Row="1" ColumnSpacing="18" x:Name="ContentGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ResultsColumn" Width="330"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Results / suggestions card -->
            <Border x:Name="ResultsCard" Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Padding="20,14,20,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ResultsHeader" Grid.Column="0" Text="Results" Style="{StaticResource SectionHeaderStyle}"/>
                        <ProgressRing x:Name="ResultsSpinner" Grid.Column="1" Width="20" Height="20" IsActive="False" Visibility="Collapsed"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" Padding="14,0,14,16" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="10">

                            <!-- Recent searches strip (shown above word list when recent searches exist) -->
                            <StackPanel x:Name="RecentChipsContainer" Spacing="6" Visibility="Collapsed" Margin="4,2,4,4">
                                <TextBlock x:Name="RecentChipsHeader" Text="Recent searches" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextTertiaryBrush}"/>
                                <controls:WrapPanel x:Name="RecentChipsPanel" Spacing="6"/>
                                <Rectangle Height="1" Fill="{ThemeResource DividerBrush}" Margin="0,4,0,2"/>
                            </StackPanel>

                            <!-- Loading -->
                            <StackPanel x:Name="ResultsLoadingState" Spacing="12" Visibility="Collapsed" Margin="6,18,6,6">
                                <ProgressRing Width="28" Height="28" IsActive="True" HorizontalAlignment="Left"/>
                                <TextBlock Text="Searching dictionaries…" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="13.5"/>
                            </StackPanel>

                            <!-- Offline / error -->
                            <StackPanel x:Name="ResultsErrorState" Spacing="10" Visibility="Collapsed" Margin="6,14,6,6">
                                <FontIcon Glyph="&#xE704;" FontSize="30" Foreground="{ThemeResource BrandRedBrush}"/>
                                <TextBlock x:Name="ResultsErrorText" Text="You appear to be offline." TextWrapping="Wrap" Foreground="{ThemeResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                <TextBlock Text="Dictionary content is fetched from live sources, so an internet connection is required."
                                           TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="13"/>
                                <Button x:Name="ResultsRetryButton" Content="Retry" Style="{StaticResource ChipButtonStyle}" Foreground="{ThemeResource AccentBlueBrush}" Click="RetryButton_Click"/>
                            </StackPanel>

                            <!-- Not found -->
                            <StackPanel x:Name="ResultsNotFoundState" Spacing="10" Visibility="Collapsed" Margin="6,14,6,6">
                                <FontIcon Glyph="&#xE7BA;" FontSize="30" Foreground="{ThemeResource TextTertiaryBrush}"/>
                                <TextBlock x:Name="ResultsNotFoundText" Text="No definitions found." TextWrapping="Wrap" Foreground="{ThemeResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                <TextBlock Text="Did you mean:" FontSize="13" Foreground="{ThemeResource TextSecondaryBrush}"/>
                                <controls:WrapPanel x:Name="ResultsSuggestionPanel" Spacing="8"/>
                            </StackPanel>

                            <!-- Result list (built in code) -->
                            <StackPanel x:Name="ResultsListState" Spacing="10" Visibility="Visible" Margin="4,2,4,0">
                                <StackPanel x:Name="ResultsListHost" Spacing="4"/>
                                <TextBlock x:Name="RelatedHeader" Text="Related words" Style="{StaticResource SectionHeaderStyle}" Margin="6,10,0,2" Visibility="Collapsed"/>
                                <StackPanel x:Name="RelatedListHost" Spacing="4"/>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Detail panel card -->
            <Border x:Name="DetailCard" Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Toolbar -->
                    <Grid Grid.Row="0" Padding="14,10,14,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="BackButton" Grid.Column="0" Style="{StaticResource IconActionButtonStyle}" Click="BackButton_Click"
                                AutomationProperties.Name="Previous word" ToolTipService.ToolTip="Previous word (Alt+Left)" IsEnabled="False">
                            <FontIcon Glyph="&#xE72B;" FontSize="15"/>
                        </Button>
                        <Button x:Name="ForwardButton" Grid.Column="1" Style="{StaticResource IconActionButtonStyle}" Click="ForwardButton_Click"
                                AutomationProperties.Name="Next word" ToolTipService.ToolTip="Next word (Alt+Right)" IsEnabled="False">
                            <FontIcon Glyph="&#xE72A;" FontSize="15"/>
                        </Button>

                        <TextBlock x:Name="DetailDictLabel" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextTertiaryBrush}" FontSize="12.5"/>

                        <Button x:Name="FavoriteButton" Grid.Column="3" Style="{StaticResource IconActionButtonStyle}" Click="FavoriteButton_Click"
                                AutomationProperties.Name="Add to favorites" ToolTipService.ToolTip="Add to favorites">
                            <FontIcon x:Name="FavoriteIcon" Glyph="&#xE734;" FontSize="16"/>
                        </Button>
                        <Button x:Name="AudioQuickButton" Grid.Column="4" Style="{StaticResource IconActionButtonStyle}" Click="AudioButton_Click"
                                AutomationProperties.Name="Play pronunciation" ToolTipService.ToolTip="Play pronunciation">
                            <FontIcon Glyph="&#xE767;" FontSize="16"/>
                        </Button>
                        <Button x:Name="ShareButton" Grid.Column="5" Style="{StaticResource IconActionButtonStyle}" Click="ShareButton_Click"
                                AutomationProperties.Name="Share word" ToolTipService.ToolTip="Share">
                            <FontIcon Glyph="&#xE72D;" FontSize="15"/>
                        </Button>
                    </Grid>

                    <Rectangle Grid.Row="1" Height="1" Fill="{ThemeResource DividerBrush}" Margin="12,0,12,0"/>

                    <ScrollViewer Grid.Row="2" Padding="28,20,28,26" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="20">

                            <!-- Placeholder -->
                            <StackPanel x:Name="DetailPlaceholderState" Spacing="12" VerticalAlignment="Center" Margin="0,60,0,0">
                                <Border Width="86" Height="86" CornerRadius="20" Background="{ThemeResource AccentBlueSoftBrush}" HorizontalAlignment="Left">
                                    <TextBlock Text="O" FontFamily="Georgia" FontSize="46" FontWeight="Bold" Foreground="{ThemeResource AccentBlueBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Your dictionary workspace" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}"/>
                                <TextBlock Text="Search a word to see definitions, pronunciation, examples, synonyms, antonyms and word origins. Use Ctrl+F to jump to the search box."
                                           TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="14" MaxWidth="560"/>
                            </StackPanel>

                            <!-- Loading -->
                            <StackPanel x:Name="DetailLoadingState" Spacing="14" Visibility="Collapsed" Margin="0,60,0,0">
                                <ProgressRing Width="32" Height="32" IsActive="True" HorizontalAlignment="Left"/>
                                <TextBlock Text="Looking up the dictionary…" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="14"/>
                            </StackPanel>

                            <!-- Offline / error -->
                            <StackPanel x:Name="DetailErrorState" Spacing="10" Visibility="Collapsed" Margin="0,40,0,0">
                                <FontIcon Glyph="&#xE704;" FontSize="34" Foreground="{ThemeResource BrandRedBrush}"/>
                                <TextBlock x:Name="DetailErrorText" Text="You appear to be offline." TextWrapping="Wrap" FontSize="17" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}"/>
                                <TextBlock Text="Check your internet connection and try again."
                                           TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="13.5"/>
                                <Button Content="Retry" Style="{StaticResource ChipButtonStyle}" Foreground="{ThemeResource AccentBlueBrush}" Click="RetryButton_Click"/>
                            </StackPanel>

                            <!-- Not found -->
                            <StackPanel x:Name="DetailNotFoundState" Spacing="10" Visibility="Collapsed" Margin="0,40,0,0">
                                <FontIcon Glyph="&#xE7BA;" FontSize="34" Foreground="{ThemeResource TextTertiaryBrush}"/>
                                <TextBlock x:Name="DetailNotFoundTitle" Text="No definitions found" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="DetailNotFoundText" Text="" TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="13.5"/>
                                <TextBlock Text="Did you mean:" FontSize="13" Foreground="{ThemeResource TextSecondaryBrush}"/>
                                <controls:WrapPanel x:Name="DetailSuggestionPanel" Spacing="8"/>
                            </StackPanel>

                            <!-- Entry content (built in code) -->
                            <StackPanel x:Name="EntryPanel" Spacing="20" Visibility="Collapsed">
                                <StackPanel Spacing="8">
                                    <TextBlock x:Name="WordText" Style="{StaticResource WordHeadwordStyle}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Button x:Name="AudioButton" Style="{StaticResource IconActionButtonStyle}" Width="44" Height="44" CornerRadius="10"
                                                Background="{ThemeResource AccentBlueSoftBrush}" Click="AudioButton_Click"
                                                AutomationProperties.Name="Play pronunciation" ToolTipService.ToolTip="Play pronunciation">
                                            <FontIcon Glyph="&#xE767;" FontSize="18" Foreground="{ThemeResource AccentBlueBrush}"/>
                                        </Button>
                                        <TextBlock x:Name="PhoneticText" VerticalAlignment="Center" FontSize="18" Foreground="{ThemeResource TextSecondaryBrush}"/>
                                        <Button x:Name="TtsButton" Style="{StaticResource ChipButtonStyle}" VerticalAlignment="Center" Click="TtsButton_Click"
                                                AutomationProperties.Name="Speak with a Windows voice" ToolTipService.ToolTip="Speak with a Windows voice">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE767;" FontSize="12"/>
                                                <TextBlock Text="Say it" FontSize="12.5"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <StackPanel x:Name="EntryChipsPanel" Orientation="Horizontal" Spacing="8" Margin="0,4,0,0"/>
                                </StackPanel>

                                <!-- Meanings (built in code) -->
                                <StackPanel x:Name="MeaningsPanel" Spacing="18"/>

                                <!-- Synonyms -->
                                <StackPanel x:Name="SynonymsSection" Spacing="10" Visibility="Collapsed">
                                    <TextBlock Text="Synonyms" Style="{StaticResource SectionHeaderStyle}"/>
                                    <controls:WrapPanel x:Name="SynonymsPanel" Spacing="8"/>
                                </StackPanel>

                                <!-- Antonyms -->
                                <StackPanel x:Name="AntonymsSection" Spacing="10" Visibility="Collapsed">
                                    <TextBlock Text="Antonyms" Style="{StaticResource SectionHeaderStyle}"/>
                                    <controls:WrapPanel x:Name="AntonymsPanel" Spacing="8"/>
                                </StackPanel>

                                <!-- Etymology -->
                                <StackPanel x:Name="OriginSection" Spacing="10" Visibility="Collapsed">
                                    <TextBlock Text="Etymology" Style="{StaticResource SectionHeaderStyle}"/>
                                    <Border Background="{ThemeResource SubCardBrush}" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="1"
                                            CornerRadius="10" Padding="14,10">
                                        <TextBlock x:Name="OriginText" TextWrapping="Wrap" FontSize="13.5" Foreground="{ThemeResource TextPrimaryBrush}"/>
                                    </Border>
                                </StackPanel>

                                <!-- Source & license -->
                                <StackPanel x:Name="SourcesSection" Spacing="6" Visibility="Collapsed">
                                    <Rectangle Height="1" Fill="{ThemeResource DividerBrush}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock x:Name="SourceText" FontSize="12" Foreground="{ThemeResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                                        <Button x:Name="SourceLinkButton" Content="Open source page" FontSize="12" Style="{StaticResource ChipButtonStyle}"
                                                Padding="8,3" MinHeight="24" Click="SourceLinkButton_Click" Visibility="Collapsed"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
